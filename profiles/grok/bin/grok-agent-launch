#!/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
export PATH
RULES=$(/bin/cat /usr/local/share/hostctl/grok/hostctl.md)
exec /usr/local/libexec/grok-hostctl-bin \
  --permission-mode auto \
  --rules "$RULES" \
  --allow 'Bash(hostctl *)' \
  --deny 'Bash(sudo *)' \
  --deny 'Bash(/usr/bin/sudo *)' \
  "$@"
